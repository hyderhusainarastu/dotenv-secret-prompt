# Example environment file for a fictional project ("Acme Widgets").
# This is a fixture for dotenv-secret-prompt.zsh — copy this directory
# somewhere writable, rename this file's sibling target to .env (git-ignored),
# and run the script against it. See ../README.md "Quick start".
#
# Real .env.example files normally leave values blank; a couple of
# non-secret defaults are filled in here just to show that comments and
# already-valued lines are both parsed correctly.

# API key for the fictional Acme Widgets platform.
ACME_API_KEY=

# Shared secret used to verify inbound Acme webhook signatures.
ACME_WEBHOOK_SECRET=

# OAuth client credentials for the fictional WidgetCorp integration.
WIDGETCORP_CLIENT_ID=
WIDGETCORP_CLIENT_SECRET=

# Password for the fictional Northwind read replica.
NORTHWIND_DB_PASSWORD=

# Non-secret default — included to show non-blank lines parse fine too.
NORTHWIND_DB_PORT=5432
